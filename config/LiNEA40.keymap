#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

&mt { flavor = "balanced"; };

&lt {
    quick-tap-ms = <160>;
    tapping-term-ms = <175>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転,,,,,,,,,,,,,,,,,,,
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        wireless {
            bindings = <&sl 5>;
            key-positions = <36 9>;
        };

        mouse_R_click {
            bindings = <&mkp RCLK>;
            key-positions = <16 18>;
            layers = <1>;
        };

        mouse_C_click {
            bindings = <&mkp MCLK>;
            key-positions = <16 17 18>;
            layers = <1>;
        };

        mouse_back {
            bindings = <&mkp MB4>;
            key-positions = <6 7>;
            layers = <1>;
        };

        mouse_next {
            bindings = <&mkp MB5>;
            key-positions = <7 8>;
            layers = <1>;
        };

        insert {
            bindings = <&kp INSERT>;
            key-positions = <26 27>;
            layers = <2>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <26 25>;
            layers = <2>;
        };

        sc {
            bindings = <&screenshot>;
            key-positions = <0 1>;
            layers = <2>;
        };

        sc_crip {
            bindings = <&cripboard_screenshot>;
            key-positions = <0 1 2>;
            layers = <2>;
        };

        kakko1 {
            bindings = <&kakko1>;
            key-positions = <14 15>;
            layers = <3>;
        };

        kakko2 {
            bindings = <&kakko2>;
            key-positions = <13 16>;
            layers = <3>;
        };

        kakko3 {
            bindings = <&kakko3>;
            key-positions = <12 17>;
            layers = <3>;
        };

        kakko4 {
            bindings = <&kakko4>;
            key-positions = <27 28>;
            layers = <0>;
        };

        dquot {
            bindings = <&dquot>;
            key-positions = <25 26>;
            layers = <3>;
        };

        squot {
            bindings = <&squot>;
            key-positions = <23 24>;
            layers = <3>;
        };

        bquot {
            bindings = <&backquot>;
            key-positions = <34 23>;
            layers = <3>;
        };

        code {
            bindings = <&code>;
            key-positions = <23 33>;
        };

        f11 {
            bindings = <&kt F11>;
            key-positions = <10 11>;
            layers = <2>;
        };

        f12 {
            bindings = <&kt F12>;
            key-positions = <11 12>;
            layers = <2>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            layers = <0>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };

        mtkana: mtkana {
            compatible = "zmk,behavior-hold-tap";
            label = "MTKANA";
            bindings = <&kp>, <&henkankirikae>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            flavor = "tap-preferred";
        };
    };

    macros {
        screenshot: screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp LEFT_SHIFT>,
                <&macro_tap>,
                <&kp NUMBER_4>,
                <&macro_release>,
                <&kp LEFT_GUI &kp LEFT_SHIFT>;

            label = "SCREENSHOT";
        };

        cripboard_screenshot: cripboard_screenshot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_GUI &kp LEFT_SHIFT &kp LCTRL>,
                <&macro_tap>,
                <&kp NUMBER_4>,
                <&macro_release>,
                <&kp LEFT_GUI &kp LEFT_SHIFT &kp LCTRL>;

            label = "CRIPBOARD_SCREENSHOT";
        };

        henkankirikae: henkankirikae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LCTRL>;

            label = "HENKANKIRIKAE";
        };

        kakko1: kakko {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LPAR &kp RPAR>,
                <&macro_tap>,
                <&kp LEFT_ARROW>;

            label = "KAKKO";
        };

        kakko2: kakko2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_BRACE &kp RIGHT_BRACE>,
                <&macro_tap>,
                <&kp LEFT_ARROW>;

            label = "KAKKO2";
        };

        kakko3: kakko3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LEFT_BRACKET &kp RIGHT_BRACKET>,
                <&macro_tap>,
                <&kp LEFT_ARROW>;

            label = "KAKKO3";
        };

        kakko4: kakko4 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp LESS_THAN &kp GREATER_THAN>,
                <&macro_tap>,
                <&kp LEFT_ARROW>;

            label = "KAKKO4";
        };

        dquot: dquot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp DOUBLE_QUOTES &kp DOUBLE_QUOTES>,
                <&macro_tap>,
                <&kp LEFT_ARROW>;

            label = "DQUOT";
        };

        squot: squot {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp SQT &kp SQT>,
                <&macro_tap>,
                <&kp LEFT_ARROW>;

            label = "SQUOT";
        };

        backquot: codearea {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp GRAVE &kp GRAVE>,
                <&macro_tap>,
                <&kp LEFT_ARROW>;

            label = "CODEAREA";
        };

        code: code {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_tap>,
                <&kp GRAVE &kp GRAVE &kp GRAVE>,
                <&macro_tap>,
                <&kp RETURN &kp RETURN>,
                <&macro_tap>,
                <&kp GRAVE &kp GRAVE &kp GRAVE>,
                <&macro_tap>,
                <&kp UP_ARROW>;

            label = "CODE";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q             &kp W         &kp E  &kp R               &kp T                                        &kp Y         &kp U  &kp I      &kp O              &kp P
&kp A             &kp S         &kp D  &kp F               &kp G                                        &kp H         &kp J  &kp K      &kp L              &kp MINUS
&mt LEFT_SHIFT Z  &kp X         &kp C  &kp V               &kp B                                        &kp N         &kp M  &kp COMMA  &kp DOT            &mt RIGHT_SHIFT SLASH
&kp TAB           &kp LEFT_ALT  &none  &mtkana LEFT_GUI 0  &mt LCTRL ESC  &kp SPACE    &lt 3 BACKSPACE  &lt 2 RETURN         &mo 4      &kp RIGHT_COMMAND  &kp RIGHT_ALT
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans  &trans  &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        MOVEANDNUM {
            bindings = <
&kp KP_NUMBER_1    &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_4  &kp KP_NUMBER_5                    &kp KP_NUMBER_6  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_NUMBER_0
&kp F1             &kp F2           &kp F3           &kp F4           &kp F5                             &kp LEFT_ARROW   &kp DOWN_ARROW   &kp UP_ARROW     &kp RIGHT_ARROW  &trans
&mt LEFT_SHIFT F6  &kp F7           &kp F8           &kp F9           &kp F10                            &kp HOME         &kp PAGE_DOWN    &kp PAGE_UP      &kp END          &trans
&trans             &trans           &trans           &trans           &trans           &trans    &trans  &trans                            &trans           &trans           &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_RIGHT SCRL_LEFT>;
        };

        MARK {
            bindings = <
&kp EXCLAMATION  &kp AT  &kp HASH          &kp DOLLAR      &kp PERCENT                             &kp CARET              &kp AMPERSAND      &kp ASTERISK       &kp MINUS      &kp EQUAL
&trans           &trans  &kp LEFT_BRACKET  &kp LEFT_BRACE  &kp LEFT_PARENTHESIS                    &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE    &kp RIGHT_BRACKET  &kp PLUS       &kp TILDE
&trans           &trans  &trans            &kp SQT         &kp SEMICOLON                           &kp COLON              &kp DOUBLE_QUOTES  &kp UNDERSCORE     &kp BACKSLASH  &trans
&trans           &trans  &trans            &kp GRAVE       &trans                &trans    &trans  &trans                                    &trans             &kp PIPE       &trans
            >;

            sensor-bindings = <&re_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        TENKEY {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &kp PLUS   &kp ASTERISK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans  &trans  &trans  &trans  &trans                    &kp MINUS  &kp SLASH     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans  &trans  &trans  &trans  &trans                    &kp EQUAL  &kp COLON     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                   &trans           &kp KP_NUMBER_0  &kp PERIOD
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4
&none         &none         &none         &none         &none                               &none         &none         &none         &none           &none
&none         &none         &none         &none         &none                               &none         &none         &none         &none           &bt BT_CLR
&none         &none         &none         &none         &none         &none    &bootloader  &none                       &none         &studio_unlock  &bt BT_CLR_ALL
            >;
        };
    };
};
